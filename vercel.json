{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/firebase-config.js", "destination": "/web/firebase-config.js" },
    { "source": "/web", "destination": "/web/index.html" },
    { "source": "/web/", "destination": "/web/index.html" },
    { "source": "/web/(.*)", "destination": "/web/$1" }
  ]
}
