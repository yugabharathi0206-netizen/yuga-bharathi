rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: patients and owner/admin
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.id == userId
                    && request.resource.data.mobile is string
                    && request.resource.data.fullName is string;
      allow update: if true;
      allow delete: if false;
    }

    // Appointments collection: real patient bookings
    match /appointments/{appointmentId} {
      // Allow reading appointments (filtered by patient in application logic, owner reads all)
      allow read: if true;
      
      // Allow patients to create new booking requests with status PENDING
      allow create: if request.resource.data.id == appointmentId
                    && request.resource.data.patientName is string
                    && request.resource.data.patientPhone is string
                    && request.resource.data.date is string
                    && request.resource.data.timeSlot is string
                    && request.resource.data.status in ['PENDING', 'CONFIRMED'];
                    
      // Allow clinic doctor/staff to confirm, reject, reschedule, or complete appointments
      allow update: if request.resource.data.status in ['PENDING', 'CONFIRMED', 'COMPLETED', 'CANCELLED', 'REJECTED', 'RESCHEDULED'];
      
      allow delete: if true;
    }

    // Clinic Settings & Doctor Profile
    match /clinicProfile/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Available Slots
    match /availableSlots/{slotId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
